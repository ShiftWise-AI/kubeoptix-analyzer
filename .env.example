# Container/runtime environment
MODE=
TZ=UTC
ENV=

# Cursor (Dashboard → https://cursor.com/dashboard/api)
# Used by: PYTHONPATH=src python -m agent --mode llm
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# OpenAI-compatible alternative (if not using Cursor SDK)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Local embedded AI (example: Ollama with quantized Mistral 7B Instruct)
# EMBEDDED_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDED_API_KEY=ollama
# EMBEDDED_MODEL=mistral
# EMBEDDED_TIMEOUT_S=120

# IA embarcada local (ex.: Ollama com Mistral 12B Instruct quantizado)
EMBEDDED_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDED_API_KEY=ollama
EMBEDDED_MODEL=mistral-nemo:12b-instruct-2407-q8_0
EMBEDDED_TIMEOUT_S=300