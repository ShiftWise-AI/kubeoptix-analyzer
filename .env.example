# Local development only. In OpenShift, credentials come from SYSTEM_SETTINGS_URL.
SYSTEM_SETTINGS_URL=http://localhost:8000

# Required for: python -m agent --llm --artifacts <dir>
CURSOR_API_KEY=
CURSOR_MODEL=default

# Optional OpenAI-compatible fallback when --llm is not used.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
